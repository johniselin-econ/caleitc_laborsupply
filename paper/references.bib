@article{saez_taxpayers_2010,
	title = {Do {Taxpayers} {Bunch} at {Kink} {Points}?},
	volume = {2},
	issn = {1945-7731, 1945-774X},
	url = {https://pubs.aeaweb.org/doi/10.1257/pol.2.3.180},
