@article{abadie_using_2021,
	title = {Using {Synthetic} {Controls}: {Feasibility}, {Data} {Requirements}, and {Methodological} {Aspects}},
	volume = {59},
	issn = {0022-0515},
	shorttitle = {Using {Synthetic} {Controls}},
