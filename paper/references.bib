@misc{ferman_inference_2021,
	title = {Inference in {Diﬀerence}-in-{Diﬀerences} with {Few} {Treated} {Units} and {Spatial} {Correlation}},
	abstract = {We consider the problem of inference in Diﬀerence-in-Diﬀerences (DID) models when there are few treated units and errors are spatially correlated. We ﬁrst show that, when there is a single treated unit, existing inference methods designed for settings with few treated and many control units remain asymptotically valid when errors are weakly dependent. However, these methods may be invalid with more than one treated unit. We propose asymptotically valid, though generally conservative, inference methods for settings with more than one treated unit. These alternatives are valid even when the relevant distance metric across units is unavailable. We also present an empirical application that highlights some common misunderstandings in the use of randomization inference in DID applications, and illustrates how our results can be used to provide proper inference.},
	language = {en},
	author = {Ferman, Bruno},
	year = {2021},
}

