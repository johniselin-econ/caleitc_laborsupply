@article{chetty_using_2013,
	title = {Using {Differences} in {Knowledge} {Across} {Neighborhoods} to {Uncover} the {Impacts} of the {EITC} on {Earnings}},
	volume = {103},
	issn = {0002-8282},
	url = {https://pubs.aeaweb.org/doi/10.1257/aer.103.7.2683},
	doi = {10.1257/aer.103.7.2683},
	abstract = {We estimate the impacts of the Earned Income Tax Credit on labor supply using local variation in knowledge about the EITC schedule. We proxy for EITC knowledge in a Zip code with the fraction of individuals who manipulate reported self-employment income to maximize their EITC refund. This measure varies significantly across areas. We exploit changes in EITC eligibility at the birth of a child to estimate labor supply effects. Individuals in high-knowledge areas change wage earnings sharply to obtain larger EITC refunds relative to those in low-knowledge areas. These responses come primarily from intensive-margin earnings increases in the phase-in region. (JEL H23, H24, H31, J22, J23, J31)},
	language = {en},
	number = {7},
	urldate = {2022-04-30},
	journal = {American Economic Review},
	author = {Chetty, Raj and Friedman, John N and Saez, Emmanuel},
	month = dec,
	year = {2013},
	pages = {2683--2721},
}

@article{bitler_-work_2017,
