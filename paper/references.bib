@article{mathur_has_2016,
	title = {Has the {Affordable} {Care} {Act} increased part-time employment?},
	volume = {23},
	issn = {1350-4851, 1466-4291},
	url = {http://www.tandfonline.com/doi/full/10.1080/13504851.2015.1066483},
	doi = {10.1080/13504851.2015.1066483},
	abstract = {We examine the impact of the Affordable Care Act (ACA) on part-time employment. Because the ACA’s employer health insurance mandate applies to individuals who work 30 or more hours per week, employers may try to avoid the mandate by cutting workers’ hours below the 30-hour threshold in order to avoid having to provide them with health insurance. Although the employer mandate only went into effect in 2015, many observers have argued that forward-looking employers began to shift towards a part-time workforce well in advance of the mandate. To test this hypothesis, we examine relative shifts across two categories of parttime workers (25–29 hours and 31–35 hours). We find some evidence of a shift from the 31–35hour category into the 25–29-hour category after the passage of ACA in March 2010. However, that shift is not more pronounced among low-wage workers or among workers in industries and occupations most likely to be affected by the mandate. Thus, there is little evidence that the ACA has caused the shift across hours categories, or led to an increase in part-time employment. However, the ACA could cause a shift towards part-time work in the future as the mandate takes effect.},
	language = {en},
	number = {3},
	urldate = {2024-08-28},
	journal = {Applied Economics Letters},
	author = {Mathur, Aparna and Slavov, Sita Nataraj and Strain, Michael R.},
	month = feb,
	year = {2016},
	pages = {222--225},
}

